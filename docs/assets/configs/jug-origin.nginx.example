# Include/adapt inside the server {} that reads CephFS files.
# Use the path as mounted INSIDE that serving container.
location = /jug/sums.txt {
    root /mnt/cephfs/cdn/content;
    try_files $uri =404;
    default_type text/plain;
    open_file_cache off;
    etag off;
    if_modified_since off;
    expires off;
    add_header Cache-Control "no-store" always;
}

location ^~ /jug/v/ {
    root /mnt/cephfs/cdn/content;
    try_files $uri =404;
    default_type application/octet-stream;
    autoindex off;
    open_file_cache_errors off;
    expires off;
    # No 'always': avoid marking a 404 as cacheable for a year.
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# A separate prefix still matches when another location uses ^~ /jug/.
location ^~ /jug/.jug {
    deny all;
}
